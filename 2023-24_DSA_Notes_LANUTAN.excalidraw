      "roundness": null,
      "boundElements": null,
      "updated": 1712755481049,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "temp\ntrav\nparNdx = (lastNdx - 1)/2;\ntrav = parNdx;\nchildNdx = (parNdx * 2)+1;\nwhile (!root && !POT){\n    //inner loop to convert each subtree to POT\n    while (childNdx <= lastNdx && !POT){\n        if (RC > LC){\n            change childNdx to current RC\n        }\n        swap trav and childNdx element\n        trav = childNdx;\n        childNdx = (childNdx * 2)+1;\n    }\n    parNdx--;\n    trav = parNdx;\n    childNdx = (parNdx * 2)+1;\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "temp\ntrav\nparNdx = (lastNdx - 1)/2;\ntrav = parNdx;\nchildNdx = (parNdx * 2)+1;\nwhile (!root && !POT){\n    //inner loop to convert each subtree to POT\n    while (childNdx <= lastNdx && !POT){\n        if (RC > LC){\n            change childNdx to current RC\n        }\n        swap trav and childNdx element\n        trav = childNdx;\n        childNdx = (childNdx * 2)+1;\n    }\n    parNdx--;\n    trav = parNdx;\n    childNdx = (parNdx * 2)+1;\n}",
      "lineHeight": 1.2
    },
