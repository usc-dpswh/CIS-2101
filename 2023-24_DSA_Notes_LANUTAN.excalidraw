      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "void maxHeapify(Heap* main){\n    int temp, trav, parNdx, childNdx;\n    parNdx = (lastNdx - 1)/2;\n    trav = parNdx;\n    childNdx = (parNdx * 2)+1;\n    while (parNdx >= 0 && main->elems[parNdx] < main->elems[(parNdx * 2)+1] || \n                main->elems[parNdx] < main->elems[(parNdx * 2)+2]){\n\n    }\n} ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void maxHeapify(Heap* main){\n    int temp, trav, parNdx, childNdx;\n    parNdx = (lastNdx - 1)/2;\n    trav = parNdx;\n    childNdx = (parNdx * 2)+1;\n    while (parNdx >= 0 && main->elems[parNdx] < main->elems[(parNdx * 2)+1] || \n                main->elems[parNdx] < main->elems[(parNdx * 2)+2]){\n\n    }\n} ",
      "lineHeight": 1.2
    },
