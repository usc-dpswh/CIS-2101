      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "int deleteMin(Heap* main){\n  int min, temp;\n  int sChild = 0, ndx = 0;\n  min = main->elems[0];\n  main->elems[0] = main->elems[main->lastNdx];\n\n  while ((sChild * 2)+1 <= main->lastNdx && (sChild * 2)+2 <= main->lastNdx){\n    if (main->elems[(sChild * 2)+1] < main->elems[(sChild * 2)+2]){\n      sChild = (sChild * 2)+1;\n    } else {\n      sChild = (sChild * 2)+2;\n    }\n    temp = main->elems[sChild];\n    main->elems[sChild] = main->elems[ndx];\n    main->elems[ndx] = temp;\n    ndx = sChild;\n  }\n  return min;\n}",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int deleteMin(Heap* main){\n  int min, temp;\n  int sChild = 0, ndx = 0;\n  min = main->elems[0];\n  main->elems[0] = main->elems[main->lastNdx];\n\n  while ((sChild * 2)+1 <= main->lastNdx && (sChild * 2)+2 <= main->lastNdx){\n    if (main->elems[(sChild * 2)+1] < main->elems[(sChild * 2)+2]){\n      sChild = (sChild * 2)+1;\n    } else {\n      sChild = (sChild * 2)+2;\n    }\n    temp = main->elems[sChild];\n    main->elems[sChild] = main->elems[ndx];\n    main->elems[ndx] = temp;\n    ndx = sChild;\n  }\n  return min;\n}",
      "lineHeight": 1.25
    },
