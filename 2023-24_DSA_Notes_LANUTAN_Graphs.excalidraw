      "link": null,
      "locked": false,
      "text": "Purpose of this loop is to loop is to\nget the Transitive Closures of your\ngraph. Trust the process and\nmemorize this as this will never\nchange. This will add new additions\nof 1s to your graph.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose of this loop is to loop is to\nget the Transitive Closures of your\ngraph. Trust the process and\nmemorize this as this will never\nchange. This will add new additions\nof 1s to your graph.",
      "lineHeight": 1.15
    },
