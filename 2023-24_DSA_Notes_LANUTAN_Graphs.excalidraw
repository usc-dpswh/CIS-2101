      "updated": 1714917125908,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 2,
      "text": "it's important to initialize minWeight back to INFINITY so that we won't be\ncomparing new minWeight to past minWeight.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "it's important to initialize minWeight back to INFINITY so that we won't be\ncomparing new minWeight to past minWeight.",
