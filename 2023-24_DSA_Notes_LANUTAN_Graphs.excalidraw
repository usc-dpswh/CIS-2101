      "isDeleted": false,
      "id": "UsBu1oMk_002XKbeOwzqY",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 5019.934453416407,
      "y": 991.5606487663379,
