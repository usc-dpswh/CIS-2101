      "updated": 1714916991856,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 2,
      "text": "Initialize your edgeCount to 0 since this is what determines our loop to stop.\nInitialize our minCost so that we add it up slowly as we get new pairs of vertices.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Initialize your edgeCount to 0 since this is what determines our loop to stop.\nInitialize our minCost so that we add it up slowly as we get new pairs of vertices.",
      "lineHeight": 1.15
    },
    {
