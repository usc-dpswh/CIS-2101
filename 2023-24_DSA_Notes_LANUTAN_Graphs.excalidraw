      "frameId": null,
      "index": "biK",
      "roundness": null,
      "seed": 360493239,
      "version": 2164,
      "versionNonce": 309140025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714918639112,
      "link": null,
      "locked": false,
      "text": "Basically initialize your new graph's \nDIAGONALS to 0 because the cost of \nthe path from a vertex to ITSELF, is 0.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basically initialize your new graph's \nDIAGONALS to 0 because the cost of \nthe path from a vertex to ITSELF, is 0.",
      "lineHeight": 1.15
    },
    {
      "id": "6UskE2m3EDoE4VJegtI04",
      "type": "text",
      "x": 7450.301067674978,
      "y": 2182.440534799885,
      "width": 903.13671875,
      "height": 64.39999999999999,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
