      "locked": false,
      "fontSize": 28,
      "fontFamily": 2,
      "text": "we must have variables u, v to get index information of the pairs of vertices that have the least minWeight",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we must have variables u, v to get index information of the pairs of vertices that have the least minWeight",
      "lineHeight": 1.15
    },
    {
      "type": "text",
