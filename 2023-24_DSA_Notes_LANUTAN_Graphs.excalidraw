      "index": "biL",
      "roundness": null,
      "seed": 5671415,
      "version": 2429,
      "versionNonce": 195261559,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714918670183,
      "link": null,
      "locked": false,
      "text": "Trust the process and just memorize this. 3 for loops with same condition\nwith the only important part to memorize is the IF CONDITION.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trust the process and just memorize this. 3 for loops with same condition\nwith the only important part to memorize is the IF CONDITION.",
      "lineHeight": 1.15
    },
    {
      "id": "lFJNwJUGqpdz-kB-wrSYi",
      "type": "text",
      "x": 5985.76087148157,
      "y": 2935.0347380676735,
      "width": 809.197265625,
      "height": 804.9999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bih",
      "roundness": null,
      "seed": 881918105,
      "version": 106,
      "versionNonce": 32705561,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919679808,
      "link": null,
      "locked": false,
      "text": "void BFS (Graph main, int startingPoint, set visited) {\n    Queue A;\n    List trav;\n    A.front = -1;\n    A.rear = -1;\n    \n    visited[startingPoint] = 1;\n\n\n    enqueue(&A, startingPoint);\n    \n    while (A.front != -1) {\n        int x = front(A);\n        printf(\"%d -> \", x);\n        dequeue(&A);\n\n\n        for (trav = main.headers[x]; trav != NULL; trav = trav->next) {\n            if (!visited[trav->vertex]) {\n                visited[trav->vertex] = 1;\n                enqueue(&A, trav->vertex); \n            }\n        }\n    }\n}",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void BFS (Graph main, int startingPoint, set visited) {\n    Queue A;\n    List trav;\n    A.front = -1;\n    A.rear = -1;\n    \n    visited[startingPoint] = 1;\n\n\n    enqueue(&A, startingPoint);\n    \n    while (A.front != -1) {\n        int x = front(A);\n        printf(\"%d -> \", x);\n        dequeue(&A);\n\n\n        for (trav = main.headers[x]; trav != NULL; trav = trav->next) {\n            if (!visited[trav->vertex]) {\n                visited[trav->vertex] = 1;\n                enqueue(&A, trav->vertex); \n            }\n        }\n    }\n}",
      "lineHeight": 1.15
    },
