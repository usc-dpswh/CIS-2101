      "updated": 1714700940359,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "if we find a vertex that's been visited, use that said vertex to find its pair whose minWeight is lesser than the current minWeight",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if we find a vertex that's been visited, use that said vertex to find its pair whose minWeight is lesser than the current minWeight",
