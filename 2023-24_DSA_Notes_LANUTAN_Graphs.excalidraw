    {
      "id": "F9J5ZEy0E3sNuYQTTgbp8",
      "type": "text",
      "x": 6016.8340549419,
      "y": 3098.1390176804393,
      "width": 761.98828125,
      "height": 32.199999999999996,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
