      "index": "bip",
      "roundness": null,
      "seed": 1475949367,
      "version": 1998,
      "versionNonce": 634388409,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919248375,
      "link": null,
      "locked": false,
      "text": "In your visited array, mark your startingPoint vertex as visited.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In your visited array, mark your startingPoint vertex as visited.",
      "lineHeight": 1.15
    },
    {
      "id": "WWLWX7kss2B9qYiAdkyoS",
      "type": "text",
      "x": 6012.651573313653,
      "y": 3161.9218625112103,
      "width": 773.048828125,
      "height": 64.39999999999999,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "biq",
      "roundness": null,
      "seed": 144861593,
      "version": 2238,
      "versionNonce": 407197815,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919300076,
      "link": null,
      "locked": false,
      "text": "We then enqueue our current startingPoint as the basis for our\nBFS traversal. ",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We then enqueue our current startingPoint as the basis for our\nBFS traversal. ",
      "lineHeight": 1.15
    },
    {
      "id": "B5yU8avDM6djbgEPiRf3N",
      "type": "text",
      "x": 6012.651573313653,
      "y": 3257.073319553836,
      "width": 391.685546875,
      "height": 32.199999999999996,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bir",
      "roundness": null,
      "seed": 1286098745,
      "version": 2338,
      "versionNonce": 1815223511,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919316162,
      "link": null,
      "locked": false,
      "text": "while your queue is not empty...",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while your queue is not empty...",
      "lineHeight": 1.15
    },
    {
      "id": "yxdEedCMCljfdILaqRpif",
      "type": "text",
      "x": 6301.242805662717,
      "y": 3295.550690951567,
      "width": 785.873046875,
      "height": 96.6,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bis",
      "roundness": null,
      "seed": 22348375,
      "version": 2975,
      "versionNonce": 1707312631,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919529292,
      "link": null,
      "locked": false,
      "text": "let x get the vertex at the front of the queue. This is important\nas variable x serves as our way to mark other unvisited vertices\nas visited. ",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let x get the vertex at the front of the queue. This is important\nas variable x serves as our way to mark other unvisited vertices\nas visited. ",
      "lineHeight": 1.15
    },
    {
      "id": "VWCxAqnzi4ITqILnI309f",
      "type": "text",
      "x": 6045.065805932571,
      "y": 3419.144482648418,
      "width": 1047.45703125,
      "height": 32.199999999999996,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bit",
      "roundness": null,
      "seed": 1376938327,
      "version": 2802,
      "versionNonce": 705308055,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919562319,
      "link": null,
      "locked": false,
      "text": "we dequeue to make way for the next vertex and get its respective adjacent vertices.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we dequeue to make way for the next vertex and get its respective adjacent vertices.",
      "lineHeight": 1.15
    },
    {
      "id": "lEFs5WWq60z_QZ-mq43Cr",
      "type": "text",
      "x": 6099.438067099785,
      "y": 3613.6298783619177,
      "width": 1077.904296875,
      "height": 128.79999999999998,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "biu",
      "roundness": null,
      "seed": 1833284247,
      "version": 3412,
      "versionNonce": 81816057,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714919674345,
      "link": null,
      "locked": false,
      "text": "Purpose of this loop is so that based on our vertex x, we check its adjacent unvisited\nvertices. If it's unvisited, mark it as 1, then the vertex that was newly marked as visited\nwill be enqueued into the queue. Repeat until trav != NULL or in English, repeat until all\nadjacent vertices of vertex x has been visited and enqueued into the queue.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose of this loop is so that based on our vertex x, we check its adjacent unvisited\nvertices. If it's unvisited, mark it as 1, then the vertex that was newly marked as visited\nwill be enqueued into the queue. Repeat until trav != NULL or in English, repeat until all\nadjacent vertices of vertex x has been visited and enqueued into the queue.",
      "lineHeight": 1.15
    },
    {
      "id": "Z3aT3Mf1vaTdbO5jfUkrI",
      "type": "text",
      "x": 4599.793616596019,
      "y": 2614.376833726493,
      "width": 637.150390625,
      "height": 740.5999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "biv",
      "roundness": null,
      "seed": 14378329,
      "version": 30,
      "versionNonce": 576113881,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714921188402,
      "link": null,
      "locked": false,
      "text": "void Warshall(graphType main, graphType A){\n        int x, y, z;\n        \n        for (x = 0 ; x < MAX ; x++){\n                for (y = 0 ; y < MAX ; y++){\n                        if (main[x][y] != INF){\n                                A[x][y] = 1;\n                        } else {\n                                A[x][y] = 0;\n                        }\n                }\n        }\n        \n        for (x = 0 ; x < MAX ; x++){\n                for (y = 0 ; y < MAX ; y++){\n                        for (z = 0 ; z < MAX ; z++){\n                                if (A[y][z] == 0){\n                                        A[y][z] = A[y][x] && A[x][z];\n                                }\n                        }\n                }\n        }\n}",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void Warshall(graphType main, graphType A){\n        int x, y, z;\n        \n        for (x = 0 ; x < MAX ; x++){\n                for (y = 0 ; y < MAX ; y++){\n                        if (main[x][y] != INF){\n                                A[x][y] = 1;\n                        } else {\n                                A[x][y] = 0;\n                        }\n                }\n        }\n        \n        for (x = 0 ; x < MAX ; x++){\n                for (y = 0 ; y < MAX ; y++){\n                        for (z = 0 ; z < MAX ; z++){\n                                if (A[y][z] == 0){\n                                        A[y][z] = A[y][x] && A[x][z];\n                                }\n                        }\n                }\n        }\n}",
      "lineHeight": 1.15
    },
    {
      "id": "lWXZzLATNMrJWGhFoVwvL",
      "type": "text",
      "x": 5177.200721352926,
      "y": 2798.5431714489937,
      "width": 543.18359375,
      "height": 160.99999999999997,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "biw",
      "roundness": null,
      "seed": 706928279,
      "version": 2227,
      "versionNonce": 619788889,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1714921340979,
      "link": null,
      "locked": false,
      "text": "Purpose of this loop is to loop through your\ngraph from main(), then copying it into your\nempty graph A. If your main[x][y] is not INF\nor there is a valid pair of vertices/edge, then\nmark it is 1, otherwise 0.",
      "fontSize": 28,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose of this loop is to loop through your\ngraph from main(), then copying it into your\nempty graph A. If your main[x][y] is not INF\nor there is a valid pair of vertices/edge, then\nmark it is 1, otherwise 0.",
      "lineHeight": 1.15
    },
