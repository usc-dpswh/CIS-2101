      "roundness": null,
      "boundElements": [],
      "updated": 1714701216427,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "we must always initialize minWeight = INFINITY or else we will be comparing\nour vertices to past minWeights. same goes with our edges(u, v)",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we must always initialize minWeight = INFINITY or else we will be comparing\nour vertices to past minWeights. same goes with our edges(u, v)",
      "lineHeight": 1.15
    },
    {
      "type": "text",
      "version": 1938,
      "versionNonce": 2105474468,
      "index": "bWf",
      "isDeleted": false,
      "id": "tUmwMfbMr6T-0AIDRk6gi",
      "fillStyle": "solid",
      "strokeWidth": 2,
